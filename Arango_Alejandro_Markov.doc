<h2>Anexo: Código Fuente</h2>

<p>El código fuente de la implementación se encuentra en los siguientes archivos adjuntos:</p>

<ul>
    <li><strong>index.html</strong> — Estructura de la interfaz de usuario</li>
    <li><strong>styles.css</strong> — Estilos visuales y sistema de diseño</li>
    <li><strong>markov.js</strong> — Motor de simulación y algoritmos</li>
</ul>

<p>Para ejecutar la aplicación, abrir el archivo <strong>index.html</strong> en cualquier navegador web moderno (Chrome, Firefox, Edge).</p>

<h3>Fragmento principal del motor de simulación (markov.js)</h3>

<div class="code-block">// Simular un paso de la cadena de Markov
function markovStep(state, matrix) {
    let r = Math.random(), cum = 0;
    for (let j = 0; j &lt; matrix[state].length; j++) {
        cum += matrix[state][j];
        if (r &lt;= cum) return j;
    }
    return matrix[state].length - 1;
}

// Ejecutar simulación completa
function simulate(initState, matrix, steps) {
    const trace = [initState];
    let s = initState;
    for (let t = 0; t &lt; steps; t++) {
        s = markovStep(s, matrix);
        trace.push(s);
    }
    return trace;
}

// Calcular frecuencias relativas
function computeFrequencies(trace, n) {
    const freq = new Array(n).fill(0);
    trace.forEach(s =&gt; freq[s]++);
    return freq.map(f =&gt; f / trace.length);
}

// Calcular distribución estacionaria por iteración de potencias
function stationaryDistribution(matrix, iters = 200) {
    const n = matrix.length;
    let pi = new Array(n).fill(1 / n);
    for (let t = 0; t &lt; iters; t++) {
        const next = new Array(n).fill(0);
        for (let j = 0; j &lt; n; j++)
            for (let i = 0; i &lt; n; i++)
                next[j] += pi[i] * matrix[i][j];
        pi = next;
    }
    return pi;
}</div>

